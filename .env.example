# Copy to .env and fill in. Never commit .env.

# Server
PORT=3100
HOST=127.0.0.1
NODE_ENV=development

# Production only: the proxy hop(s) whose X-Forwarded-* headers are trusted.
# Defaults to 127.0.0.1 (Apache on the same box). Never set it to "true":
# that would let a client choose its own IP and slip past the login limiter.
# TRUST_PROXY=127.0.0.1

# SQLite file. Relative paths resolve from the working directory.
DB_PATH=./data/slowburn.db

# Where photo files are stored (created at start). Back this up with the database.
PHOTOS_DIR=./data/photos

# Output of `npm run session-key` (64 hex chars, 32 bytes).
SESSION_KEY=

# Output of `npm run hash-password` (scrypt:<salt>:<hash>).
APP_PASSWORD_HASH=
