# Copy to .env and fill in. Never commit .env.

# Server
PORT=3100
HOST=127.0.0.1
NODE_ENV=development

# SQLite file. Relative paths resolve from the working directory.
DB_PATH=./data/slowburn.db

# Where photo files are stored (created at start). Back this up with the database.
PHOTOS_DIR=./data/photos

# Output of `npm run session-key` (64 hex chars, 32 bytes).
SESSION_KEY=

# Output of `npm run hash-password` (scrypt:<salt>:<hash>).
APP_PASSWORD_HASH=
