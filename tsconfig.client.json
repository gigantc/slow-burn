{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": [
      "vite/client",
      "vite-plugin-pwa/client"
    ],
    "paths": {
      "@/*": [
        "./src/client/*"
      ],
      "shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/client",
    "src/shared"
  ]
}
