{
  "name": "slow-burn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.client.json --noEmit && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/server/db/migrate.ts",
    "hash-password": "node scripts/hash-password.mjs",
    "session-key": "node scripts/session-key.mjs",
    "deploy": "bash deploy/deploy.sh",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.9",
    "@fastify/secure-session": "^8.4.2",
    "@fastify/static": "^10.1.11",
    "@fastify/type-provider-typebox": "^6.3.0",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "sharp": "^0.35.5",
    "typebox": "^1.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.10.1",
    "sass-embedded": "^1.108.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
